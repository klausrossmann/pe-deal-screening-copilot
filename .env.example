POSTGRES_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pe_screening
POSTGRES_DB=pe_screening
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Embedding provider: sentence_transformers, openai, or google
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM provider for the ask/screening workflows: openai, google, or groq
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Max LLM calls in flight at once. Keep 1 on free tiers (Groq: 8K tokens/minute); e.g. 8 on paid tiers.
LLM_MAX_CONCURRENCY=1

# Retrieval: drop chunks with a cosine distance above this. Depends on the embedding model;
# 0.70 was measured for all-MiniLM-L6-v2 (see retrieval.md). Leave empty for no cutoff.
RETRIEVAL_MAX_DISTANCE=0.70

# Where screening results are saved and reused (see use-cases.md, "Saved results")
ANALYSIS_DIR=data/analysis

# OpenAI
OPENAI_API_KEY=

# Google
GOOGLE_API_KEY=

# Groq
GROQ_API_KEY=
